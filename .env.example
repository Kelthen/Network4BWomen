# Copier vers .env.local et remplir. NE JAMAIS committer .env.local.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # serveur uniquement (routes API)

# Stripe (dons) — zone rhamon
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# PayPal (optionnel) — lien de don PUBLIC. Bouton "Donate" hébergé PayPal
# (https://www.paypal.com/donate?hosted_button_id=XXXX) ou PayPal.me
# (https://paypal.me/VotreNom). Vide = bouton PayPal masqué.
NEXT_PUBLIC_PAYPAL_DONATE_URL=

# Email transactionnel (contact) — Resend. Sans clé = formulaire inactif (ou base seule).
# RESEND_FROM optionnel : "NBW <hello@ton-domaine.ca>" une fois le domaine vérifié dans Resend ;
# sinon l'adresse de test Resend est utilisée par défaut.
RESEND_API_KEY=
RESEND_FROM=
# CONTACT_NOTIFY_TO : où arrivent les notifications de contact. Défaut = l'adresse NBW.
# Tant que le domaine n'est PAS vérifié dans Resend, mettre ici l'adresse vérifiée du
# compte Resend (sinon Resend renvoie 403 pour les destinataires tiers).
CONTACT_NOTIFY_TO=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (optionnel) — Google Analytics 4. Chargé UNIQUEMENT après consentement cookies.
# Laisser vide = pas d'analytics. Renseigner l'ID pour activer (ex. G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=
